	"item": [
		{
			"name": "getUser",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"    pm.collectionVariables.set(\"provider_uuid\",pm.response.json().results[0].uuid)",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"auth": {
					"type": "basic",
					"basic": [
						{
							"key": "password",
							"value": "{{password}}",
							"type": "string"
						},
						{
							"key": "username",
							"value": "{{provider_name}}",
							"type": "string"
						}
					]
				},
				"method": "GET",
				"header": [
					{
						"key": "Cache-Control",
						"value": "max-age=0, no-store",
						"type": "default"
					}
				],
				"url": {
					"raw": "{{url}}/openmrs/ws/rest/v1/user?v=custom:(username,uuid,person:(uuid,),privileges:(name,retired),userProperties)&username={{provider_name}}",
					"host": [
						"{{url}}"
					],
					"path": [
						"openmrs",
						"ws",
						"rest",
						"v1",
						"user"
					],
					"query": [
						{
							"key": "v",
							"value": "custom:(username,uuid,person:(uuid,),privileges:(name,retired),userProperties)"
						},
						{
							"key": "username",
							"value": "{{provider_name}}"
						}
					]
				}
			},
			"response": []
		},

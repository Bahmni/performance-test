		},
		{
			"name": "getLocationUUID",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"set the location uuid's\",()=>{",
							"",
							"let responseJson = pm.response.json();",
							"responseJson.results.forEach(location => {",
							"    if (location.display === pm.environment.get(\"login_location_name\")) {",
							"        pm.collectionVariables.set(\"login_location_uuid\", location.uuid);",
							"    }",
							"    if (location.display === pm.environment.get(\"visit_location_name\")) {",
							"        pm.collectionVariables.set(\"visit_location_uuid\", location.uuid);",
							"    }",
							"});",
							"})"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{url}}/openmrs/ws/rest/v1/location",
					"host": [
						"{{url}}"
					],
					"path": [
						"openmrs",
						"ws",
						"rest",
						"v1",
						"location"
					]
				}
			},
			"response": []
		},
		{
			"name": "get all patients",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"get all active visit ids\",  () =>",
							"{",
							"    var res=pm.response.json()",
							"    var ids=[]",
							"    if(res.length>0)",
							"    {",
							"    res.forEach(e=>{",
							"        ids.push(e.activeVisitUuid)",
							"    })",
							"    }",
							"    pm.collectionVariables.set('ids',ids)",
							"});",
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{url}}/openmrs/ws/rest/v1/bahmnicore/sql?location_uuid={{login_location_uuid}}&provider_uuid={{provider_uuid}}&q=emrapi.sqlSearch.activePatients&v=full",
					"host": [
						"{{url}}"
					],
					"path": [
						"openmrs",
						"ws",
						"rest",
						"v1",
						"bahmnicore",
						"sql"
					],
					"query": [
						{
							"key": "location_uuid",
							"value": "{{login_location_uuid}}"
						},
						{
							"key": "provider_uuid",
							"value": "{{provider_uuid}}"
						},
						{
							"key": "q",
							"value": "emrapi.sqlSearch.activePatients"
						},
						{
							"key": "v",
							"value": "full"
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "close visit",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"let ids = pm.collectionVariables.get(\"ids\");",
							"if(ids.length>0)",
							"{",
							"let currentid = ids.shift();",
							"pm.collectionVariables.set(\"id\", currentid);",
							"pm.collectionVariables.set(\"ids\", ids);",
							"}else{",
							"    pm.request.url = \"{{url}}\";",
							"}"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"const ids = pm.collectionVariables.get(\"ids\");",
							"console.log(ids)",
							"if (ids.length > 0){",
							"    postman.setNextRequest(\"close visit\");",
							"} else {",
							"    postman.setNextRequest(null);",
							"}",
							"",
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							""
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"withCredentials\": true\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{url}}/openmrs/ws/rest/v1/bahmnicore/visit/endVisit?visitUuid={{id}}",
					"host": [

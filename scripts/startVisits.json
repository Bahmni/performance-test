		},
		{
			"name": "getLocationUUID",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"set the location uuid's\",()=>{",
							"",
							"let responseJson = pm.response.json();",
							"responseJson.results.forEach(location => {",
							"    if (location.display === pm.environment.get(\"login_location_name\")) {",
							"        pm.collectionVariables.set(\"login_location_uuid\", location.uuid);",
							"    }",
							"    if (location.display === pm.environment.get(\"visit_location_name\")) {",
							"        pm.collectionVariables.set(\"visit_location_uuid\", location.uuid);",
							"    }",
							"});",
							"})"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{url}}/openmrs/ws/rest/v1/location",
					"host": [
						"{{url}}"
					],
					"path": [
						"openmrs",
						"ws",
						"rest",
						"v1",
						"location"
					]
				}
			},
			"response": []
		},
		{
			"name": "getIdentifierUUID",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"set the identifier uuid's\",()=>{",
							"    let responseJson = pm.response.json();",
							"let identifierSourceUuid;",
							"let identifierTypeUuid;",
							"",
							"responseJson.results.forEach(source => {",
							"    if (source.display.includes(\" - \"+pm.environment.get(\"identifierPrefix\")+\" -\")) {",
							"        identifierSourceUuid = source.uuid;",
							"        identifierTypeUuid = source.identifierType.uuid;",
							"    }",
							"});",
							"",
							"if (identifierSourceUuid) {",
							"    pm.collectionVariables.set(\"identifierSource_uuid\", identifierSourceUuid);",
							"    console.log(\"identifierSource_uuid:\", identifierSourceUuid);",
							"} else {",
							"    console.log(\"No identifier source found with display containing '- ABC -'\");",
							"}",
							"",
							"if (identifierTypeUuid) {",
							"    pm.collectionVariables.set(\"identifierType_uuid\", identifierTypeUuid);",
							"    console.log(\"identifierType_uuid:\", identifierTypeUuid);",
							"} else {",
							"    console.log(\"No identifier type found for the source with display containing '- ABC -'\");",
							"}",
							"})"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{url}}/openmrs/ws/rest/v1/idgen/identifiersource",

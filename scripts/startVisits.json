		{
			"name": "create patient",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"var bool=pm.variables.replaceIn(\"{{$randomBoolean}}\")",
							"pm.test(\"set create patient variables\",function(){",
							"",
							"pm.collectionVariables.set(\"name\",pm.variables.replaceIn(\"{{$randomFirstName}}\"))",
							"if(bool == 'true')",
							"{",
							"  pm.collectionVariables.set(\"gender\",\"M\")  ",
							"}",
							"else",
							"{",
							"  pm.collectionVariables.set(\"gender\",\"F\")  ",
							"",
							"}})",
							"",
							"pm.test(\"set bdate\",function(){",
							"var phonenumber=pm.variables.replaceIn(\"{{$randomPhoneNumber}}\").replaceAll('-','')",
							"pm.globals.set('phonenumber','+91'+phonenumber)",
							"if(bool == 'true')",
							"{",
							"  pm.collectionVariables.set(\"bdate\",\"1982-03-02T13:25:18.649+0530\") ",
							"}",
							"else",
							"{",
							"  pm.collectionVariables.set(\"bdate\",\"2003-03-02T13:25:18.649+0530\")  ",
							"",
							"}",
							"})",
							"",
							"",
							"",
							"",
							"",
							""
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"set patient id\",function(){",
							"    var res=pm.response.json()",
							"    counter=pm.environment.get('patientsCount')",
							"    ids=pm.collectionVariables.get('ids')",
							"    if (counter >1)",
							"    {",
							"        ids.push(res.patient.uuid)",
							"        postman.setNextRequest(\"create patient\");",
							"        pm.environment.set('patientsCount',counter-1)",
							"} else ",
							"{",
							"    ids.push(res.patient.uuid)",
							"    postman.setNextRequest(\"start visit\");",
							"}",
							"    pm.collectionVariables.set('ids',ids)",
							"})"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"patient\": {\n        \"person\": {\n            \"names\": [\n                {\n                    \"givenName\": \"{{name}}\",\n                    \"familyName\": \"Demo\",\n                    \"display\": \"{{name}} Demo\",\n                    \"preferred\": false\n                }\n            ],\n            \"addresses\": [\n                {}\n            ],\n            \"birthdate\": \"{{bdate}}\",\n            \"gender\": \"{{gender}}\",\n            \"birthtime\": null,\n            \"attributes\": [         ],\n            \"deathDate\": null,\n            \"causeOfDeath\": \"\"\n        },\n        \"identifiers\": [\n            {\n                \"identifierSourceUuid\": \"{{identifierSource_uuid}}\",\n                \"identifierPrefix\": \"{{identifierPrefix}}\",\n                \"identifierType\": \"{{identifierType_uuid}}\",\n                \"preferred\": true,\n                \"voided\": false\n            }\n        ]\n    },\n    \"relationships\": []\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{url}}/openmrs/ws/rest/v1/bahmnicore/patientprofile",
					"host": [
						"{{url}}"
					],
					"path": [
						"openmrs",
						"ws",
						"rest",
						"v1",
						"bahmnicore",
						"patientprofile"
					]
				}
			},
			"response": []
		},
		{
			"name": "start visit",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"let ids = pm.collectionVariables.get(\"ids\");",
							"if(ids.length>0)",
							"{",
							"let currentid = ids.shift();",
							"pm.collectionVariables.set(\"id\", currentid);",
							"pm.collectionVariables.set(\"ids\", ids);",
							"}"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"const ids = pm.collectionVariables.get(\"ids\");",
							"console.log(ids)",
							"if (ids.length > 0){",
							"    postman.setNextRequest(\"start visit\");",
							"} else {",
							"    postman.setNextRequest(null);",
							"}",
							"",
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"// Environment variables",
							"const url = pm.environment.get(\"url\");",
							"const provider_name = pm.environment.get(\"provider_name\");",
							"const password = pm.environment.get(\"password\");",
							"",
							"// Collection variables",
							"const login_location_uuid = pm.collectionVariables.get(\"login_location_uuid\");",
							"const visit_location_uuid = pm.collectionVariables.get(\"visit_location_uuid\");",
							"const patient_document_encounter_type_uuid = pm.collectionVariables.get(\"PATIENT_DOCUMENT_ENCOUNTER_TYPE_UUID\");",
							"const radiology_encounter_type_uuid = pm.collectionVariables.get(\"RADIOLOGY_ENCOUNTER_TYPE_UUID\");",
							"const registration_encounter_type_uuid = pm.collectionVariables.get(\"REGISTRATION_ENCOUNTER_TYPE_UUID\");",
							"const consultation_encounter_type_uuid = pm.collectionVariables.get(\"CONSULTATION_ENCOUNTER_TYPE_UUID\");",
							"const provider_uuid = pm.collectionVariables.get(\"provider_uuid\");",
							"",
							"// Construct the command to run the shell script with arguments",
							"const command = `./updateConstants.sh ${url} ${provider_name} ${password} ${login_location_uuid} ${visit_location_uuid} ${patient_document_encounter_type_uuid} ${radiology_encounter_type_uuid} ${registration_encounter_type_uuid} ${consultation_encounter_type_uuid} ${provider_uuid}`;",
							"console.log(command);",
							"// pm.test(\"Run shell script to update constants.scala\", function() {",
							"//     const exec = require('child_process').exec;",
							"//     exec(command, (error, stdout, stderr) => {",
							"//         if (error) {",
							"//             console.error(`Error: ${error}`);",
							"//             return;",
							"//         }",
							"//         console.log(`stdout: ${stdout}`);",
							"//         console.error(`stderr: ${stderr}`);",
							"//     });",
							"// });",
							""
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",

		{
			"name": "get visitType",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"set the visit type\",()=>{",
							"",
							"var res=pm.response.json()",
							"",
							"var typeId=res.visitTypes[pm.environment.get(\"visit_type\")]",
							"pm.collectionVariables.set(\"typeId\",typeId)",
							"pm.collectionVariables.set(\"ids\",[])",
							"pm.collectionVariables.set(\"PATIENT_DOCUMENT_ENCOUNTER_TYPE_UUID\",res.encounterTypes[\"Patient Document\"])",
							"pm.collectionVariables.set(\"CONSULTATION_ENCOUNTER_TYPE_UUID\",res.encounterTypes.Consultation)",
							"pm.collectionVariables.set(\"REGISTRATION_ENCOUNTER_TYPE_UUID\",res.encounterTypes.REG)",
							"pm.collectionVariables.set(\"RADIOLOGY_ENCOUNTER_TYPE_UUID\",res.encounterTypes.RADIOLOGY)",
							"})",
							"",
							""
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{url}}/openmrs/ws/rest/v1/bahmnicore/config/bahmniencounter?callerContext=REGISTRATION_CONCEPTS",
					"host": [
